{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:prod && npm run prerender",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cssville-web\\.vercel\\.app" }],
      "destination": "https://cssville.xyz/:path*",
      "permanent": true
    },
    { "source": "/docs", "destination": "/docs/intro/getting-started", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/app" }]
}
